{
  "expo": {
    "name": "ecwa-expo",
    "slug": "ecwa-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecwaexpo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.peemozi.ecwaexpo",
      "usesCleartextTraffic": true,
      "networkSecurityConfig": {
        "cleartextTrafficPermitted": true
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8000/api"
    },
    "env": {
      "EXPO_PUBLIC_API_BASE_URL": "http://localhost:8000/api",
      "EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY": "pk_test_47df0e5a57e3e82902a4d75629068aececcb9917",
      "_comment": "For mobile devices, the app will automatically replace 'localhost' with your computer's IP address. To manually set your IP, add: EXPO_PUBLIC_API_IP=192.168.1.x (replace with your actual IP)"
    },
    "_comment": "API temporarily disabled - see src/lib/api.ts USE_API flag to re-enable. For mobile: The app auto-detects your LAN IP from Expo. If it doesn't work, set EXPO_PUBLIC_API_IP environment variable with your computer's IP address (e.g., 192.168.1.100)"
  }
}
